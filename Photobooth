<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Photo Booth Juliefy Lens</title>
    
    <!-- React & ReactDOM CDN -->
    <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide-react@0.359.0/dist/umd/lucide-react.min.js"></script>
    
    <!-- Babel JIT Compiler for JSX processing in older/static environments -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    
    <!-- Elegant Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Space+Grotesk:wght@300..700&family=JetBrains+Mono:wght@300..700&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: "Space Grotesk", "Inter", sans-serif;
            background-color: #1c1917; /* stone-900 */
        }
        .serif-font {
            font-family: "Playfair Display", Georgia, serif;
        }
        .mono-font {
            font-family: "JetBrains Mono", monospace;
        }
        
        /* 3D Button Bevel Effects */
        .btn-red-3d {
            background: linear-gradient(180deg, #ef4444 0%, #b91c1c 100%);
            border-bottom: 5px solid #7f1d1d;
            transition: all 0.1s ease;
        }
        .btn-red-3d:active {
            transform: translateY(3px);
            border-bottom: 2px solid #7f1d1d;
        }
        
        .btn-cyan-3d {
            background: linear-gradient(180deg, #06b6d4 0%, #0891b2 100%);
            border-bottom: 5px solid #164e63;
            transition: all 0.1s ease;
        }
        .btn-cyan-3d:active {
            transform: translateY(3px);
            border-bottom: 2px solid #164e63;
        }
        
        .btn-gray-3d {
            background: linear-gradient(180deg, #4b5563 0%, #374151 100%);
            border-bottom: 5px solid #111827;
            transition: all 0.1s ease;
        }
        .btn-gray-3d:active {
            transform: translateY(3px);
            border-bottom: 2px solid #111827;
        }
        
        /* Repetitive theatrical red velvet curtain background pattern */
        .bg-velvet {
            background: repeating-linear-gradient(
                90deg,
                #5f0404 0px,
                #5f0404 40px,
                #4a0303 40px,
                #4a0303 80px,
                #3c0202 80px,
                #3c0202 120px,
                #4a0303 120px,
                #4a0303 160px
            );
        }
        
        /* Pastel sky / amber elements */
        .bg-sky-teal {
            background: linear-gradient(135deg, #a7f3d0 0%, #60a5fa 100%);
        }
        
        /* Custom scrollbar helper */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.2);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(250, 204, 21, 0.3);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(250, 204, 21, 0.6);
        }
    </style>
</head>
<body class="text-stone-100 select-none antialiased selection:bg-amber-850">
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useRef } = React;

        // Safe LucideReact destructuring wrapper. Falls back to emoji indicators if CDN fails or is blocked.
        const getLucideIcon = (name, fallbackChar = '') => {
            if (typeof LucideReact !== 'undefined' && LucideReact[name]) {
                return LucideReact[name];
            }
            return (props) => (
                <span className={`inline-flex items-center justify-center font-mono font-bold ${props.className || ''}`} style={{ fontSize: props.size ? props.size - 2 : 12 }}>
                    {fallbackChar || name.slice(0, 2).toUpperCase()}
                </span>
            );
        };

        const Camera = getLucideIcon('Camera', '📷');
        const Download = getLucideIcon('Download', '⬇️');
        const Trash2 = getLucideIcon('Trash2', '🗑️');
        const User = getLucideIcon('User', '👤');
        const HelpCircle = getLucideIcon('HelpCircle', '❓');
        const Info = getLucideIcon('Info', 'ℹ️');
        const LogOut = getLucideIcon('LogOut', '🚪');
        const ImageIcon = getLucideIcon('Image', '🖼️');
        const Check = getLucideIcon('Check', '✓');
        const CheckSquare = getLucideIcon('CheckSquare', '☑️');
        const Square = getLucideIcon('Square', '⬜');
        const RefreshCw = getLucideIcon('RefreshCw', '🔄');
        const Sliders = getLucideIcon('Sliders', '⚙️');
        const ZoomIn = getLucideIcon('ZoomIn', '➕');
        const ZoomOut = getLucideIcon('ZoomOut', '➖');
        const Move = getLucideIcon('Move', '✥');
        const Settings = getLucideIcon('Settings', '🛠️');
        const ArrowRight = getLucideIcon('ArrowRight', '➡️');
        const ExternalLink = getLucideIcon('ExternalLink', '🔗');

        // Default template layout data with standard percentage coordinates
        const DEFAULT_TEMPLATES = [
            {
                id: 'temp1',
                name: 'Template 1 (Photostrip 4-Foto)',
                url: 'https://lh3.googleusercontent.com/d/1CNbOJ8qMWIx1vY2mus5v7MoWHYtrjsXW',
                slotsCount: 4,
                layoutType: 'vertical-4',
                slots: [
                    { x: 10, y: 5, width: 80, height: 20 },
                    { x: 10, y: 28, width: 80, height: 20 },
                    { x: 10, y: 51, width: 80, height: 20 },
                    { x: 10, y: 74, width: 80, height: 20 },
                ]
            },
            {
                id: 'temp2',
                name: 'Template 2 (Grid 2x2 Classic)',
                url: 'https://lh3.googleusercontent.com/d/1ZJn71yIVb1Pm25u6GxokP-W8gq5kp5xV',
                slotsCount: 4,
                layoutType: 'grid-2x2',
                slots: [
                    { x: 8, y: 8, width: 40, height: 38 },
                    { x: 52, y: 8, width: 40, height: 38 },
                    { x: 8, y: 52, width: 40, height: 38 },
                    { x: 52, y: 52, width: 40, height: 38 },
                ]
            },
            {
                id: 'temp3',
                name: 'Template 3 (Strip 3-Foto)',
                url: 'https://lh3.googleusercontent.com/d/19tII5DnQTSuOOxpgFE3dsi0I7KmByXF7',
                slotsCount: 3,
                layoutType: 'vertical-3',
                slots: [
                    { x: 10, y: 8, width: 80, height: 26 },
                    { x: 10, y: 37, width: 80, height: 26 },
                    { x: 10, y: 66, width: 80, height: 26 },
                ]
            },
            {
                id: 'temp4',
                name: 'Template 4 (Duo Portrait)',
                url: 'https://lh3.googleusercontent.com/d/1reqV1ywp4pl5QCu6ziNVcIdw-BXS5ATH',
                slotsCount: 2,
                layoutType: 'vertical-2',
                slots: [
                    { x: 10, y: 10, width: 80, height: 38 },
                    { x: 10, y: 52, width: 80, height: 38 },
                ]
            },
            {
                id: 'temp5',
                name: 'Template 5 (Grid 2x2 Soft)',
                url: 'https://lh3.googleusercontent.com/d/1g6T1LcxswEE5ybdciNScbfzHd9xzjSju',
                slotsCount: 4,
                layoutType: 'grid-2x2',
                slots: [
                    { x: 10, y: 8, width: 38, height: 36 },
                    { x: 52, y: 8, width: 38, height: 36 },
                    { x: 10, y: 48, width: 38, height: 36 },
                    { x: 52, y: 48, width: 38, height: 36 },
                ]
            }
        ];

        function App() {
            // General Screen navigation: 'login' | 'booth' | 'gallery' | 'about' | 'help'
            const [currentPage, setCurrentPage] = useState('login');
            
            // Subtle sheet toggler on login screen
            const [showSecretSettings, setShowSecretSettings] = useState(false);
            
            // User states
            const [userName, setUserName] = useState(() => localStorage.getItem('user_name') || '');
            const [isLoggedIn, setIsLoggedIn] = useState(() => !!localStorage.getItem('user_name'));
            const [sheetsUrl, setSheetsUrl] = useState(() => localStorage.getItem('sheets_url') || 'https://script.google.com/macros/s/AKfycby7V-MizGfU4fL8A9vQ3vjUHe_YJHe0eD-hQo9Vw-8b-8vFv86OPr_A_ex6G8E1G6Vz/exec');
            
            // Photo Database (Saved locally in browser client for portability)
            const [galleryPhotos, setGalleryPhotos] = useState(() => {
                try {
                    const saved = localStorage.getItem('gallery_photos');
                    return saved ? JSON.parse(saved) : [];
                } catch {
                    return [];
                }
            });

            // Active templates states
            const [templates, setTemplates] = useState(DEFAULT_TEMPLATES);
            const [selectedTemplate, setSelectedTemplate] = useState(DEFAULT_TEMPLATES[0]);
            
            // Camera Stream States
            const [cameraActive, setCameraActive] = useState(false);
            const [cameraStream, setCameraStream] = useState(null);
            const [cameraError, setCameraError] = useState(null);
            const [availableDevices, setAvailableDevices] = useState([]);
            const [selectedCameraId, setSelectedCameraId] = useState('');
            
            // Shoot configuration state
            const [timerDuration, setTimerDuration] = useState(0); // 0 = off, 3, 5, 10
            const [countdown, setCountdown] = useState(-1);
            const [showFlash, setShowFlash] = useState(false);
            const [isShootingSession, setIsShootingSession] = useState(false);
            
            // Placements database tracker (coordinates and zooms inside slots)
            const [sessionPlacements, setSessionPlacements] = useState(() => 
                Array(4).fill(null).map(() => ({ photoId: null, scale: 1, xOffset: 0, yOffset: 0, rotation: 0 }))
            );
            const [activeSlotIndex, setActiveSlotIndex] = useState(0);
            
            // Gallery selection filter mode
            const [galleryMode, setGalleryMode] = useState('individual');
            const [editTargetTemplate, setEditTargetTemplate] = useState(DEFAULT_TEMPLATES[0]);
            const [isEditModalOpen, setIsEditModalOpen] = useState(false);
            
            // Refs
            const videoRef = useRef(null);
            const canvasRef = useRef(null);

            // Sync gallery to local storage when changed
            useEffect(() => {
                localStorage.setItem('gallery_photos', JSON.stringify(galleryPhotos));
            }, [galleryPhotos]);

            // Sync template sizes when template switches
            useEffect(() => {
                setSessionPlacements(
                    Array(selectedTemplate.slotsCount).fill(null).map((_, idx) => {
                        return sessionPlacements[idx] || { photoId: null, scale: 1, xOffset: 0, yOffset: 0, rotation: 0 };
                    })
                );
                setActiveSlotIndex(0);
            }, [selectedTemplate]);

            // Visibility tracker: turn off camera completely when backgrounded!
            useEffect(() => {
                const handleVisibility = () => {
                    if (document.hidden) {
                        stopCamera();
                    } else if (currentPage === 'booth' && isLoggedIn) {
                        startCamera(selectedCameraId);
                    }
                };
                document.addEventListener('visibilitychange', handleVisibility);
                return () => document.removeEventListener('visibilitychange', handleVisibility);
            }, [currentPage, isLoggedIn, selectedCameraId]);

            // Manage camera streams beautifully
            const stopCamera = () => {
                if (cameraStream) {
                    cameraStream.getTracks().forEach(track => track.stop());
                    setCameraStream(null);
                }
                if (videoRef.current) {
                    videoRef.current.srcObject = null;
                }
                setCameraActive(false);
            };

            const startCamera = async (deviceId) => {
                stopCamera();
                try {
                    setCameraError(null);
                    const constraints = {
                        video: {
                            width: { ideal: 1280 },
                            height: { ideal: 720 },
                            deviceId: deviceId ? { exact: deviceId } : undefined
                        }
                    };
                    const stream = await navigator.mediaDevices.getUserMedia(constraints);
                    setCameraStream(stream);
                    setCameraActive(true);
                    
                    if (videoRef.current) {
                        videoRef.current.srcObject = stream;
                        videoRef.current.play().catch(e => console.error("Play error:", e));
                    }

                    const devices = await navigator.mediaDevices.enumerateDevices();
                    const videos = devices.filter(d => d.kind === 'videoinput');
                    setAvailableDevices(videos);
                    if (!selectedCameraId && videos.length > 0) {
                        setSelectedCameraId(videos[0].deviceId);
                    }
                } catch (err) {
                    console.error("Camera access failed", err);
                    const errMsg = err?.message || err?.name || String(err);
                    let localizedError = "Akses kamera dilarang atau diabaikan oleh browser Anda.";
                    if (errMsg.toLowerCase().includes("permission") || errMsg.toLowerCase().includes("dismiss") || errMsg.toLowerCase().includes("allow") || err?.name === "NotAllowedError" || err?.name === "PermissionDeniedError") {
                        localizedError = "Izin kamera ditolak atau ditutup (Permission dismissed). Silakan atur izin akses kamera ke 'Izinkan' di bar alamat browser Anda.";
                    } else if (errMsg.toLowerCase().includes("notfound") || err?.name === "NotFoundError") {
                        localizedError = "Tidak ada kamera yang ditemukan pada perangkat Anda.";
                    }
                    setCameraError(`${localizedError} (Sistem: ${errMsg})`);
                    setCameraActive(false);
                }
            };

            // Manage booth background stream activation
            useEffect(() => {
                if (currentPage === 'booth' && isLoggedIn) {
                    startCamera(selectedCameraId);
                } else {
                    stopCamera();
                }
                return () => stopCamera();
            }, [currentPage, isLoggedIn]);

            // Keep videoRef stream in sync with active camera stream when elements mount
            React.useEffect(() => {
                if (videoRef.current && cameraStream) {
                    if (videoRef.current.srcObject !== cameraStream) {
                        videoRef.current.srcObject = cameraStream;
                        videoRef.current.play().catch(e => console.error("Error playing video:", e));
                    }
                }
            }, [cameraStream, currentPage]);

            // Fallback image upload for HP / Laptop if the camera remains black or is blocked by iframe constraints
            const handleFallbackImageUpload = (e) => {
                const file = e.target.files && e.target.files[0];
                if (!file) return;

                const reader = new FileReader();
                reader.onload = (event) => {
                    const dataUrl = event.target && event.target.result;
                    if (!dataUrl) return;

                    const newPhoto = {
                        id: 'photo_' + Date.now() + '_' + Math.floor(Math.random() * 1000),
                        dataUrl: dataUrl,
                        timestamp: new Date().toLocaleTimeString('id-ID'),
                        selected: false
                    };

                    setGalleryPhotos(prev => [newPhoto, ...prev]);

                    // Place image inside the active photo slot automatically
                    setSessionPlacements(prev => {
                        const next = [...prev];
                        next[activeSlotIndex] = {
                            ...next[activeSlotIndex],
                            photoId: newPhoto.id
                        };
                        return next;
                    });

                    // Stagger and advance the slot guide
                    setActiveSlotIndex(prev => (prev + 1) % selectedTemplate.slotsCount);
                };
                reader.readAsDataURL(file);
            };

            // Submit record logs to google sheets
            const submitToGoogleSheets = async (name) => {
                if (!sheetsUrl || !sheetsUrl.startsWith('http')) return;
                const payload = {
                    nama: name,
                    tanggal: new Date().toLocaleString('id-ID'),
                    device: navigator.userAgent
                };
                try {
                    await fetch(sheetsUrl, {
                        method: 'POST',
                        mode: 'no-cors',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                } catch (e) {
                    console.error("Sheet submit failed", e);
                }
            };

            // Authenticate and login submission
            const handleLoginSubmit = (e) => {
                e.preventDefault();
                if (!userName.trim()) return;
                localStorage.setItem('user_name', userName.trim());
                localStorage.setItem('sheets_url', sheetsUrl.trim());
                setIsLoggedIn(true);
                submitToGoogleSheets(userName.trim());
                setCurrentPage('booth');
            };

            const handleLogOut = () => {
                localStorage.removeItem('user_name');
                setUserName('');
                setIsLoggedIn(false);
                setCurrentPage('login');
                stopCamera();
            };

            // Capture raw photo from stream
            const captureShutter = () => {
                if (!cameraActive || !videoRef.current) return;
                
                if (timerDuration > 0) {
                    setIsShootingSession(true);
                    setCountdown(timerDuration);
                    const interval = setInterval(() => {
                        setCountdown((prev) => {
                            if (prev <= 1) {
                                clearInterval(interval);
                                executeActualCapture();
                                return -1;
                            }
                            return prev - 1;
                        });
                    }, 1000);
                } else {
                    executeActualCapture();
                }
            };

            const executeActualCapture = () => {
                if (!videoRef.current) return;
                const canvas = document.createElement('canvas');
                // Capture at high resolution
                canvas.width = 1200;
                canvas.height = 900;
                const ctx = canvas.getContext('2d');
                if (!ctx) return;
                
                // Mirror horizontally to match normal live selfie preview!
                ctx.translate(canvas.width, 0);
                ctx.scale(-1, 1);
                ctx.drawImage(videoRef.current, 0, 0, canvas.width, canvas.height);
                ctx.setTransform(1, 0, 0, 1, 0, 0); // reset transform
                
                // Show flashy white visual indicator
                setShowFlash(true);
                setTimeout(() => setShowFlash(false), 200);

                const dataUrl = canvas.toDataURL('image/jpeg', 0.9);
                const newPhoto = {
                    id: 'photo_' + Date.now() + '_' + Math.floor(Math.random()*1000),
                    dataUrl: dataUrl,
                    timestamp: new Date().toLocaleTimeString()
                };

                setGalleryPhotos((prev) => [newPhoto, ...prev]);

                // Place inside selected template slot
                setSessionPlacements((prev) => {
                    const next = [...prev];
                    next[activeSlotIndex] = { ...next[activeSlotIndex], photoId: newPhoto.id };
                    return next;
                });

                // Auto shift to next slot
                setActiveSlotIndex((prev) => (prev + 1) % selectedTemplate.slotsCount);
                setIsShootingSession(false);
            };

            // Custom positioning mechanics
            const updatePlacement = (slotIdx, field, val) => {
                setSessionPlacements((prev) => {
                    const next = [...prev];
                    next[slotIdx] = { ...next[slotIdx], [field]: val };
                    return next;
                });
            };

            const changeZoom = (mult) => {
                const cur = sessionPlacements[activeSlotIndex].scale;
                let next = cur + mult;
                if (next < 0.2) next = 0.2;
                if (next > 4) next = 4;
                updatePlacement(activeSlotIndex, 'scale', parseFloat(next.toFixed(2)));
            };

            const changePan = (axis, amount) => {
                const currentVal = sessionPlacements[activeSlotIndex][axis];
                updatePlacement(activeSlotIndex, axis, currentVal + amount);
            };

            const changeRotate = (deg) => {
                const currentVal = sessionPlacements[activeSlotIndex].rotation;
                updatePlacement(activeSlotIndex, 'rotation', (currentVal + deg) % 360);
            };

            const selectPhotoForActiveSlot = (photoId) => {
                setSessionPlacements((prev) => {
                    const next = [...prev];
                    next[activeSlotIndex] = { ...next[activeSlotIndex], photoId };
                    return next;
                });
            };

            const removePhotoFromSlot = (slotIdx) => {
                setSessionPlacements((prev) => {
                    const next = [...prev];
                    next[slotIdx] = { ...next[slotIdx], photoId: null };
                    return next;
                });
            };

            const deleteGalleryPhoto = (id, e) => {
                if (e) e.stopPropagation();
                if (confirm("Hapus foto dari galeri?")) {
                    setGalleryPhotos((prev) => prev.filter(p => p.id !== id));
                    setSessionPlacements((prev) => prev.map(p => p.photoId === id ? { ...p, photoId: null } : p));
                }
            };

            // Canvas renderer to merge selected compositions with beautiful backgrounds
            const generateAndDownloadComposite = (targetTemplate, placements, bypassDownload = false) => {
                return new Promise((resolve) => {
                    const canvas = document.createElement('canvas');
                    canvas.width = 800;
                    canvas.height = 1200; // Classic 2:3 physical photostrip ratio 
                    const ctx = canvas.getContext('2d');
                    if (!ctx) { resolve(null); return; }

                    // Fill beautiful solid white vintage backing
                    ctx.fillStyle = '#ffffff';
                    ctx.fillRect(0, 0, canvas.width, canvas.height);

                    let loadedCount = 0;
                    const filledPlacements = placements.filter(p => p.photoId);

                    const finishAndBuild = () => {
                        const templateImg = new Image();
                        templateImg.crossOrigin = 'anonymous';
                        templateImg.src = targetTemplate.url;
                        
                        templateImg.onload = () => {
                            ctx.drawImage(templateImg, 0, 0, canvas.width, canvas.height);
                            // Add copyright watermarks
                            ctx.font = 'bold 20px "Playfair Display"';
                            ctx.fillStyle = '#C05C23';
                            ctx.textAlign = 'center';
                            ctx.fillText(`JULIEFY LENS © ${new Date().getFullYear()}`, canvas.width / 2, canvas.height - 25);

                            const mergedUrl = canvas.toDataURL('image/png');
                            if (!bypassDownload) {
                                const link = document.createElement('a');
                                link.download = `photostrip_juliefy_${Date.now()}.png`;
                                link.href = mergedUrl;
                                link.click();
                            }
                            resolve(mergedUrl);
                        };

                        templateImg.onerror = () => {
                            // High quality golden vectors as safety fallback when Google CORS gets blocked!
                            ctx.strokeStyle = '#D27D2D';
                            ctx.lineWidth = 14;
                            ctx.strokeRect(8, 8, canvas.width - 16, canvas.height - 16);
                            
                            ctx.fillStyle = '#4a0303'; // red velvet
                            ctx.fillRect(14, 14, canvas.width - 28, 85);

                            ctx.fillStyle = '#fef08a';
                            ctx.font = 'bold italic 30px "Playfair Display"';
                            ctx.textAlign = 'center';
                            ctx.fillText("JULIEFY RETRO LENS", canvas.width / 2, 65);

                            ctx.fillStyle = '#D27D2D';
                            ctx.fillRect(14, canvas.height - 65, canvas.width - 28, 4);

                            ctx.fillStyle = '#555555';
                            ctx.font = 'bold 15px "JetBrains Mono"';
                            ctx.fillText(`NAMA: ${userName.toUpperCase()} | ${new Date().toLocaleDateString('id-ID')}`, canvas.width / 2, canvas.height - 28);

                            const mergedUrl = canvas.toDataURL('image/png');
                            if (!bypassDownload) {
                                const link = document.createElement('a');
                                link.download = `photostrip_fallback_${Date.now()}.png`;
                                link.href = mergedUrl;
                                link.click();
                            }
                            resolve(mergedUrl);
                        };
                    };

                    if (filledPlacements.length === 0) {
                        finishAndBuild();
                        return;
                    }

                    // Render individual slots
                    placements.forEach((placement, idx) => {
                        const slot = targetTemplate.slots[idx];
                        if (!slot || !placement.photoId) return;

                        const photoData = galleryPhotos.find(p => p.id === placement.photoId);
                        if (!photoData) {
                            loadedCount++;
                            if (loadedCount === filledPlacements.length) finishAndBuild();
                            return;
                        }

                        const img = new Image();
                        img.src = photoData.dataUrl;
                        img.onload = () => {
                            const sx = (slot.x / 100) * canvas.width;
                            const sy = (slot.y / 100) * canvas.height;
                            const sw = (slot.width / 100) * canvas.width;
                            const sh = (slot.height / 100) * canvas.height;

                            ctx.save();
                            ctx.beginPath();
                            ctx.rect(sx, sy, sw, sh);
                            ctx.clip(); // clip outer layout boundary

                            const cx = sx + sw / 2;
                            const cy = sy + sh / 2;

                            ctx.translate(cx, cy);
                            ctx.rotate((placement.rotation * Math.PI) / 180);
                            
                            // Aspect ratio fitting calculations
                            const imgAspect = img.width / img.height;
                            const slotAspect = sw / sh;
                            let renderW, renderH;

                            if (imgAspect > slotAspect) {
                                renderH = sh * placement.scale;
                                renderW = renderH * imgAspect;
                            } else {
                                renderW = sw * placement.scale;
                                renderH = renderW / imgAspect;
                            }

                            ctx.drawImage(
                                img, 
                                -renderW / 2 + placement.xOffset, 
                                -renderH / 2 + placement.yOffset, 
                                renderW, 
                                renderH
                            );
                            ctx.restore();

                            loadedCount++;
                            if (loadedCount === filledPlacements.length) finishAndBuild();
                        };
                        
                        img.onerror = () => {
                            loadedCount++;
                            if (loadedCount === filledPlacements.length) finishAndBuild();
                        };
                    });
                });
            };

            return (
