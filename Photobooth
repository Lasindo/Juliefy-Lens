                                                setGalleryPhotos([]);
                                                setSessionPlacements(prev => prev.map(p => ({ ...p, photoId: null })));
                                            }
                                        }}
                                        className="px-4 py-2 bg-red-800 hover:bg-red-700 text-red-200 text-xs font-bold rounded-lg border border-red-900"
                                    >
                                        Bersihkan Semua
                                    </button>
                                </div>
                            </div>

                            {galleryPhotos.length === 0 ? (
                                <div className="bg-stone-950 p-12 rounded-3xl border border-stone-850 text-center text-stone-500 max-w-md mx-auto space-y-3">
                                    <ImageIcon size={48} className="mx-auto text-stone-700" />
                                    <p className="font-serif italic text-sm">Galeri masih kosong. Silakan masuk ke Booth dan potret momen terbaik Anda!</p>
                                </div>
                            ) : (
                                <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
                                    {galleryPhotos.map((p) => (
                                        <div key={p.id} className="bg-stone-900 border border-stone-800 p-2 rounded-xl flex flex-col justify-between relative group hover:border-yellow-500 transition shadow">
                                            <div className="relative aspect-square overflow-hidden rounded-lg bg-black-80">
                                                <img src={p.dataUrl} className="w-full h-full object-cover" />
                                            </div>
                                            <div className="mt-2 flex justify-between items-center">
                                                <span className="text-[10px] font-mono text-stone-500">{p.timestamp}</span>
                                                <button 
                                                    onClick={(e) => deleteGalleryPhoto(p.id, e)}
                                                    className="p-1.5 bg-stone-950 text-red-400 hover:text-red-300 rounded border border-stone-800"
                                                    title="Hapus"
                                                >
                                                    <Trash2 size={12} />
                                                </button>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            )}
                        </div>
                    )}

                    {/* ABOUT PAGE SCREEN */}
                    {currentPage === 'about' && (
                        <div className="max-w-2xl mx-auto px-6 py-12">
                            <div className="bg-stone-900 p-8 rounded-3xl border border-stone-800 space-y-6 shadow-2xl">
                                <h2 className="text-3xl font-bold font-serif text-transparent bg-clip-text bg-gradient-to-r from-yellow-100 to-amber-400">Tentang Juliefy Lens</h2>
                                <div className="space-y-4 text-stone-300 text-sm leading-relaxed">
                                    <p>Juliefy Lens adalah studio photobooth digital yang menggabungkan estetika retro klasik dengan kepraktisan teknologi modern, dirancang sebagai single-page app 100% mandiri yang berjalan lancar di peramban tanpa server.</p>
                                    <p>Memiliki penyesuaian sumbu letak foto (zooming dan panning) pada masing-masing slot frame untuk memberikan Anda fleksibilitas pengaturan estetika terbaik.</p>
                                </div>
                                <button onClick={() => setCurrentPage(isLoggedIn ? 'booth' : 'login')} className="px-5 py-2.5 bg-yellow-600 hover:bg-yellow-500 text-stone-950 font-bold text-xs rounded-xl">
                                    Tutup & Kembali
                                </button>
                            </div>
                        </div>
                    )}

                    {/* HELP PAGE SCREEN */}
                    {currentPage === 'help' && (
                        <div className="max-w-2xl mx-auto px-6 py-12">
                            <div className="bg-stone-900 p-8 rounded-3xl border border-stone-800 space-y-6 shadow-2xl">
                                <h2 className="text-3xl font-bold font-serif text-transparent bg-clip-text bg-gradient-to-r from-yellow-105 to-yellow-300">Cara Menggunakan</h2>
                                <div className="space-y-4 text-stone-300 text-xs sm:text-sm leading-relaxed">
                                    <ol className="list-decimal pl-5 space-y-3">
                                        <li><strong className="text-white">Masukan Nama:</strong> Ketik nama Anda di halaman login untuk memulai sesi photobooth Anda.</li>
                                        <li><strong className="text-white">Pilih Template:</strong> Ketuk template photostrip di bilah samping kiri untuk memilih jumlah slot and format.</li>
                                        <li><strong className="text-white">Memotret / Mengisi Slot:</strong> Klik tombol bundar merah di tengah untuk menjepret. Foto akan secara otomatis masuk ke slot aktif Anda.</li>
                                        <li><strong className="text-white">Atur Lokasi (Pivot):</strong> Gunakan tombol Zoom In/Out, Putar, dan Geser di bilah penyesuaian di bawah kamera untuk menyempurnakan letak potret.</li>
                                        <li><strong className="text-white">Download Strip:</strong> Jika slot sudah terisi penuh, klik "Download Photostrip" untuk mengekspor file PNG berkualitas tinggi ke galeri lokal Anda!</li>
                                    </ol>
                                </div>
                                <button onClick={() => setCurrentPage(isLoggedIn ? 'booth' : 'login')} className="px-5 py-2.5 bg-yellow-600 hover:bg-yellow-500 text-stone-950 font-bold text-xs rounded-xl">
                                    Tutup & Kembali
                                </button>
                            </div>
                        </div>
                    )}
                </div>
            );
        }

        const container = document.getElementById('root');
        const root = ReactDOM.createRoot(container);
        root.render(<App />);
    </script>
</body>
</html>
